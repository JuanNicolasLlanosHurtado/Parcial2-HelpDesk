<%- include('partials/header', { titulo: titulo, activa: activa }) %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
  <h1 class="titulo-medio m-0">Panel de <em>tickets</em></h1>
  <div class="contador">
    <span class="contador-numero"><%= tickets.length %></span>
    <span class="contador-texto">fallas<br>registradas</span>
  </div>
</div>

<% if (tickets.length === 0) { %>

  <div class="tarjeta tarjeta-verde text-center py-5">
    <div class="vacio-emoji">🎉</div>
    <h2>¡Todo funciona correctamente!</h2>
    <p class="mb-0">No hay fallas pendientes.</p>
  </div>

<% } else { %>

  <div class="table-responsive tarjeta tarjeta-blanca p-0">
    <table class="table tabla align-middle mb-0">
      <thead>
        <tr>
          <th>_id</th>
          <th>Solicitante</th>
          <th>Aula</th>
          <th>Problema</th>
          <th>Fecha</th>
          <th class="text-center">Acción</th>
        </tr>
      </thead>
      <tbody>
        <% tickets.forEach(function(t) { %>
          <tr>
            <td><span class="etiqueta-id"><%= t._id %></span></td>
            <td><%= t.solicitante %></td>
            <td><span class="chip"><%= t.ubicacion %></span></td>
            <td><%= t.descripcion %></td>
            <td><%= t.fecha.toLocaleString('es-CO') %></td>
            <td class="text-center">
              <form action="/admin/resolver" method="POST"
                    onsubmit="return confirm('¿Seguro que este problema ya quedó resuelto? Se eliminará de MongoDB.');">
                <input type="hidden" name="idTicket" value="<%= t._id %>">
                <button type="submit" class="btn boton boton-verde boton-chico">Resuelto</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

<% } %>

<%- include('partials/footer') %>
